:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5c78e163c580 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5c78e163c710 .scope module, "Program_counter" "Program_counter" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 1 "Next_instruction_flag";
    .port_info 3 /OUTPUT 32 "Pc";
o0x705473dcf018 .functor BUFZ 1, C4<z>; HiZ drive
L_0x5c78e164cac0 .functor BUFZ 1, o0x705473dcf018, C4<0>, C4<0>, C4<0>;
L_0x5c78e164cb50 .functor BUFZ 32, v0x5c78e164c850_0, C4<00000000000000000000000000000000>, C4<00000000000000000000000000000000>, C4<00000000000000000000000000000000>;
v0x5c78e1601640_0 .net "Next_instruction_flag", 0 0, o0x705473dcf018;  0 drivers
v0x5c78e164c610_0 .net "Next_instruction_flag_internal", 0 0, L_0x5c78e164cac0;  1 drivers
v0x5c78e164c6d0_0 .net "Pc", 31 0, L_0x5c78e164cb50;  1 drivers
o0x705473dcf0a8 .functor BUFZ 1, C4<z>; HiZ drive
v0x5c78e164c790_0 .net "clk", 0 0, o0x705473dcf0a8;  0 drivers
v0x5c78e164c850_0 .var "counter", 31 0;
o0x705473dcf108 .functor BUFZ 1, C4<z>; HiZ drive
v0x5c78e164c980_0 .net "reset", 0 0, o0x705473dcf108;  0 drivers
E_0x5c78e1601c80 .event posedge, v0x5c78e164c790_0;
S_0x5c78e1601490 .scope module, "cocotb_iverilog_dump" "cocotb_iverilog_dump" 4 1;
 .timescale -9 -12;
    .scope S_0x5c78e163c710;
T_0 ;
    %wait E_0x5c78e1601c80;
    %load/vec4 v0x5c78e164c980_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0x5c78e164c850_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5c78e164c610_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x5c78e164c850_0;
    %addi 4, 0, 32;
    %assign/vec4 v0x5c78e164c850_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5c78e1601490;
T_1 ;
    %vpi_call/w 4 3 "$dumpfile", "sim_build/Program_counter.fst" {0 0 0};
    %vpi_call/w 4 4 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5c78e163c710 {0 0 0};
    %end;
    .thread T_1;
